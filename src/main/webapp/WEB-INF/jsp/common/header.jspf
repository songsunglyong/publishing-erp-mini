<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<spring:htmlEscape defaultHtmlEscape="true"/>
<!doctype html>
<html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>출판 ERP Mini</title><link rel="stylesheet" href="/webjars/bootstrap/5.3.8/css/bootstrap.min.css"><link rel="stylesheet" href="/css/app.css">
<meta name="csrf-token" content="<c:out value='${_csrf.token}'/>"></head>
<body><nav class="navbar border-bottom bg-white"><div class="container"><a class="navbar-brand fw-bold" href="/">출판 ERP Mini</a><div class="d-flex gap-4"><a href="/books">도서</a><a href="/partners">거래처</a><a href="/orders">주문</a><a href="/inventory">재고</a><a href="/reports/sales">보고서</a>
<c:if test="${not empty currentUser}"><a href="/employees/${currentUser.id}">내 정보</a><a href="/account/password">비밀번호 변경</a>
<c:if test="${pageContext.request.isUserInRole('ADMIN')}"><a href="/admin/users">계정 관리</a></c:if>
<form method="post" action="/logout"><input type="hidden" name="_csrf" value="<c:out value='${_csrf.token}'/>"><button class="btn btn-sm btn-outline-secondary">로그아웃</button></form></c:if></div></div></nav>
<main class="container py-4"><p class="text-secondary small">로컬 시연용 · 합성 데이터만 입력하세요.</p>
<c:if test="${not empty notice}"><div class="alert alert-success" role="status"><c:out value="${notice}"/></div></c:if>

<%@ include file="error-notice.jspf" %>
