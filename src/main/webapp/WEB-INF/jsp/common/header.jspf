<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<spring:htmlEscape defaultHtmlEscape="true"/>
<!doctype html>
<html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>출판 ERP Mini</title><link rel="stylesheet" href="/webjars/bootstrap/5.3.8/css/bootstrap.min.css"><link rel="stylesheet" href="/css/app.css">
<meta name="csrf-token" content="<c:out value='${csrfToken}'/>"></head>
<body><nav class="navbar border-bottom bg-white"><div class="container"><a class="navbar-brand fw-bold" href="/">출판 ERP Mini</a><div class="d-flex gap-4"><a href="/books">도서</a><a href="/partners">거래처</a></div></div></nav>
<main class="container py-4"><p class="text-secondary small">로컬 시연용 · 합성 데이터만 입력하세요. 로그인·권한은 Phase 3에서 추가됩니다.</p>
<c:if test="${not empty notice}"><div class="alert alert-success" role="status"><c:out value="${notice}"/></div></c:if>
