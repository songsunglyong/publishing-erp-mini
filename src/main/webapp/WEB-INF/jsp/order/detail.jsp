<%@ page pageEncoding="UTF-8" %><%@ include file="../common/header.jspf" %>
<h1>주문 상세</h1><p><c:out value="${order.orderNo}"/> · <c:out value="${order.partnerName}"/> · <spring:message code="order.status.${order.status}"/></p><p>주문 금액 <fmt:formatNumber value="${order.totalAmount}"/>원 · 누적 반품 <fmt:formatNumber value="${order.returnedAmount}"/>원</p><p><c:out value="${order.notes}"/></p>
<table class="table"><thead><tr><th>도서 (주문 당시)</th><th>수량</th><th>단가</th><th>금액</th><th>반품 수량</th></tr></thead><tbody><c:forEach var="item" items="${order.items}"><tr><td><c:out value="${item.bookTitle}"/></td><td><c:out value="${item.quantity}"/></td><td><fmt:formatNumber value="${item.unitPrice}"/>원</td><td><fmt:formatNumber value="${item.lineTotal}"/>원</td><td><c:out value="${item.returnedQuantity}"/></td></tr></c:forEach></tbody></table>
<c:if test="${pageContext.request.isUserInRole('ADMIN') or pageContext.request.isUserInRole('MANAGER')}"><div class="actions">
<c:if test="${order.status == 'DRAFT'}"><form method="post" action="/orders/${order.id}/confirm"><input type="hidden" name="_csrf" value="<c:out value='${_csrf.token}'/>"><button class="btn btn-primary">확정</button></form></c:if>
<c:if test="${order.status == 'CONFIRMED'}"><form method="post" action="/orders/${order.id}/fulfill" data-confirm="재고를 차감하고 출고하시겠습니까?"><input type="hidden" name="_csrf" value="<c:out value='${_csrf.token}'/>"><button class="btn btn-primary">출고</button></form></c:if>
<c:if test="${order.status == 'DRAFT' or order.status == 'CONFIRMED'}"><form method="post" action="/orders/${order.id}/cancel" data-confirm="주문을 취소하시겠습니까?"><input type="hidden" name="_csrf" value="<c:out value='${_csrf.token}'/>"><button class="btn btn-outline-danger">주문 취소</button></form></c:if></div>
<c:if test="${order.status == 'FULFILLED'}"><h2 class="mt-4">부분 반품</h2><p>반품하지 않을 품목은 0으로 두세요. 반품 후에도 주문 상태는 출고 완료이며 아래 이력으로 구분합니다.</p>
<form:form modelAttribute="returnForm" method="post" action="/orders/${order.id}/returns" htmlEscape="true"><input type="hidden" name="_csrf" value="<c:out value='${_csrf.token}'/>"><form:hidden path="requestKey"/><form:errors path="*" cssClass="alert alert-danger" element="div"/>
<c:forEach var="item" items="${order.items}" varStatus="loop"><div class="row my-2"><div class="col"><c:out value="${item.bookTitle}"/> (남은 반품 가능: <c:out value="${item.quantity-item.returnedQuantity}"/>)</div><div class="col"><form:hidden path="items[${loop.index}].itemId"/><form:input path="items[${loop.index}].quantity" type="number" min="0" max="${item.quantity-item.returnedQuantity}" cssClass="form-control" aria-label="반품 수량"/></div></div></c:forEach>
<form:label path="reason">반품 사유</form:label><form:textarea path="reason" maxlength="500" cssClass="form-control mb-3"/><button class="btn btn-outline-primary">반품 처리</button></form:form></c:if></c:if>
<h2 class="mt-4">반품 이력</h2><table class="table"><thead><tr><th>처리 시각</th><th>사유</th><th>반품 금액</th></tr></thead><tbody><c:forEach var="record" items="${returns}"><tr><td><c:out value="${record.returnedAt}"/></td><td><c:out value="${record.reason}"/></td><td><fmt:formatNumber value="${record.totalAmount}"/>원</td></tr></c:forEach></tbody></table><a href="/orders">주문 목록</a>
<%@ include file="../common/footer.jspf" %>
