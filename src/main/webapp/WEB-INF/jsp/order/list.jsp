<%@ page pageEncoding="UTF-8" %><%@ include file="../common/header.jspf" %>
<div class="actions"><h1>주문 관리</h1><c:if test="${pageContext.request.isUserInRole('ADMIN') or pageContext.request.isUserInRole('MANAGER')}"><a class="btn btn-primary" href="/orders/new">주문 등록</a></c:if></div>
<form:form method="get" action="/orders" modelAttribute="query" cssClass="card card-body mb-3"><div class="row g-2"><div class="col"><form:label path="q">주문번호·거래처명</form:label><form:input path="q" cssClass="form-control" maxlength="100"/></div><div class="col"><form:label path="status">주문 상태</form:label><form:select path="status" cssClass="form-select"><form:option value="">전체</form:option><form:option value="DRAFT">작성</form:option><form:option value="CONFIRMED">확정</form:option><form:option value="FULFILLED">출고 완료</form:option><form:option value="CANCELLED">취소</form:option></form:select></div><div class="col-auto align-self-end"><button class="btn btn-dark">검색</button></div></div></form:form>
<table class="table"><thead><tr><th>주문번호</th><th>거래처</th><th>상태</th><th>금액</th><th>주문 시각</th></tr></thead><tbody><c:forEach var="row" items="${result.items}"><tr><td><a href="/orders/${row.id}"><c:out value="${row.orderNo}"/></a></td><td><c:out value="${row.partnerName}"/></td><td><spring:message code="order.status.${row.status}"/></td><td><fmt:formatNumber value="${row.totalAmount}"/>원</td><td><c:out value="${row.orderedAt}"/></td></tr></c:forEach><c:if test="${empty result.items}"><tr><td colspan="5">조건에 맞는 주문이 없습니다.</td></tr></c:if></tbody></table><c:set var="section" value="orders"/><%@ include file="../common/pagination.jspf" %>
<%@ include file="../common/footer.jspf" %>
