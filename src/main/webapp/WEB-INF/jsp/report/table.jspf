<%@ page pageEncoding="UTF-8" %>
<h2 class="mt-4"><c:out value="${reportTitle}"/></h2><table class="table"><thead><tr><th>구분</th><th>출고 매출</th><th>반품 차감</th><th>순매출</th><th>출고 수량</th><th>반품 수량</th></tr></thead><tbody><c:forEach var="row" items="${reportRows}"><tr><td><c:out value="${row.label}"/></td><td><fmt:formatNumber value="${row.grossAmount}"/>원</td><td><fmt:formatNumber value="${row.returnAmount}"/>원</td><td><fmt:formatNumber value="${row.netAmount}"/>원</td><td><c:out value="${row.shippedQuantity}"/></td><td><c:out value="${row.returnedQuantity}"/></td></tr></c:forEach><c:if test="${empty reportRows}"><tr><td colspan="6">해당 기간의 매출 내역이 없습니다.</td></tr></c:if></tbody></table>
