<%@ page pageEncoding="UTF-8" %><%@ include file="../common/header.jspf" %>
<h1>현재 재고</h1><div class="actions mb-3"><a class="btn btn-outline-secondary" href="/inventory/movements">재고 원장</a><c:if test="${pageContext.request.isUserInRole('ADMIN') or pageContext.request.isUserInRole('MANAGER')}"><a class="btn btn-primary" href="/inventory/receipts">입고</a></c:if><c:if test="${pageContext.request.isUserInRole('ADMIN')}"><a class="btn btn-outline-primary" href="/inventory/adjustments">조정</a></c:if></div>
<form:form method="get" action="/inventory" modelAttribute="query" cssClass="actions mb-3"><form:label path="q">도서명·ISBN</form:label><form:input path="q" cssClass="form-control" maxlength="100"/><button class="btn btn-dark">검색</button></form:form>
<table class="table"><thead><tr><th>도서</th><th>ISBN</th><th>재고</th><th>사용 상태</th><th>원장</th></tr></thead><tbody><c:forEach var="row" items="${result.items}"><tr><td><c:out value="${row.title}"/></td><td><c:out value="${row.isbn}"/></td><td><c:out value="${row.quantityOnHand}"/>권</td><td>${row.active ? '사용' : '비활성'}</td><td><a href="/inventory/movements?bookId=${row.bookId}">이력 보기</a></td></tr></c:forEach><c:if test="${empty result.items}"><tr><td colspan="5">조건에 맞는 재고가 없습니다.</td></tr></c:if></tbody></table><c:set var="section" value="inventory"/><%@ include file="../common/pagination.jspf" %>
<%@ include file="../common/footer.jspf" %>
