<%@ page pageEncoding="UTF-8" %><%@ include file="../common/header.jspf" %>
<h1>재고 원장</h1><form:form method="get" action="/inventory/movements" modelAttribute="query" cssClass="actions"><form:label path="bookId">도서 번호 (선택)</form:label><form:input path="bookId" type="number" min="1" cssClass="form-control"/><button class="btn btn-dark">조회</button></form:form>
<table class="table"><thead><tr><th>시각</th><th>도서</th><th>유형</th><th>증감</th><th>처리 후 잔액</th><th>참조</th><th>사유</th></tr></thead><tbody><c:forEach var="row" items="${result.items}"><tr><td><c:out value="${row.createdAt}"/></td><td><c:out value="${row.title}"/></td><td><spring:message code="movement.type.${row.type}"/></td><td><c:out value="${row.quantity}"/></td><td><c:out value="${row.balanceAfter}"/></td><td><c:out value="${row.referenceType}"/> #<c:out value="${row.referenceId}"/></td><td><c:out value="${row.note}"/></td></tr></c:forEach><c:if test="${empty result.items}"><tr><td colspan="7">재고 이력이 없습니다.</td></tr></c:if></tbody></table><c:set var="section" value="inventory/movements"/><%@ include file="../common/pagination.jspf" %>
<%@ include file="../common/footer.jspf" %>
