# Optional external MariaDB configuration. Export these variables in your terminal.
# Scripts automatically load generated .local/db.env for the project-local DB.
DB_URL=jdbc:mariadb://127.0.0.1:3307/publishing_erp
DB_USERNAME=erp_app
DB_PASSWORD=replace-with-your-own-local-secret
TEST_DB_URL=jdbc:mariadb://127.0.0.1:3307/publishing_erp_test
TEST_DB_USERNAME=erp_test
TEST_DB_PASSWORD=replace-with-your-own-test-secret

# Compose 준비용: .env에 복사한 후 각 암호를 서로 다른 임의 값으로 변경한다.
# 현재 Docker 실행·배포는 미검증. doc/CONTAINERS.md 참고.
COMPOSE_DB_PASSWORD=
COMPOSE_DB_ROOT_PASSWORD=
# 최초 관리자 암호는 12자 이상, 최소 영문/숫자 조합을 사용한다.
COMPOSE_ADMIN_PASSWORD=
COMPOSE_ADMIN_USERNAME=admin
COMPOSE_PORT=8080
